{
  "manifest_version": 3,
  "name": "Tracking Automation Pro",
  "version": "1.1.0",
  "description": "أتمتة إدخال أرقام تتبع الطرود + اختصارات نصية سريعة في أي موقع",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "shortcuts.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "start-automation": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "بدء الأتمتة"
    },
    "pause-automation": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "إيقاف مؤقت"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}