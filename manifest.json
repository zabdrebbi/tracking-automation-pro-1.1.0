{
  "manifest_version": 3,
  "name": "Tracking Automation Pro",
  "version": "1.2.0",
  "description": "أتمتة إدخال أرقام تتبع الطرود + اختصارات نصية سريعة في أي موقع + بحث ذكي في ياليدين",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Cairo.ttf",
        "fonts/IBMPlexMono-Var.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "shortcuts.js",
        "quick-search.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "open-yalidine-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "فتح بحث ياليدين السريع"
    },
    "open-yalidine-history": {
      "suggested_key": {
        "default": "Ctrl+Shift+H"
      },
      "description": "فتح سجل بحث ياليدين"
    },
    "start-automation": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "بدء الأتمتة"
    },
    "pause-automation": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "إيقاف مؤقت"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}